# LiveKit Cloud credentials
LIVEKIT_URL=wss://voice-agent-pbze1g6w.livekit.cloud
LIVEKIT_API_KEY=APISmwxKSZABEMZ
LIVEKIT_API_SECRET=U9dYaBF4J0mtVEAr4KD1J41t3uPoWccLNUccWNQDzvD

# Sarvam credentials
SARVAM_API_KEY=sk_l12op0ll_tbcreLIa1fY89w9OOnnn8Ndn

# LiveKit Inference LLM model (recommended default)
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it

# ── Outbound telephony: Vobiz AI via LiveKit SIP (Twilio removed) ────────────
# 1) Vobiz console → enable outbound SIP trunk (domain/username/password)
# 2) LiveKit → create outbound SIP trunk with those credentials
# 3) Paste the trunk ID below and set DIALER_ENABLED=true
DIALER_ENABLED=false
DIALER_POLL_INTERVAL_SECONDS=10
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-vobiz-outbound-trunk-id-from-livekit
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# ── Call recording (real calls only; test calls are never recorded) ──────────
# Requires storage (S3) to be configured on your LiveKit project's egress.
RECORDING_ENABLED=false
RECORDING_S3_BUCKET=your-s3-bucket-name

# Agent identity
LIVEKIT_AGENT_NAME=yantric-agent

# Prompt file used by Assistant instructions
AGENT_PROMPT_PATH=prompts/assistant_prompt.txt

# Initial greeting instruction at session start
INITIAL_REPLY_INSTRUCTIONS=Greet the user warmly, then ask how you can help.

# Sarvam STT config
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_FLUSH_SIGNAL=true

# Sarvam TTS config
SARVAM_TTS_TARGET_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_MIN_BUFFER_SIZE=50
SARVAM_TTS_MAX_CHUNK_LENGTH=150
SARVAM_TTS_SEND_COMPLETION_EVENT=true

# Optional: model used by tests to judge response intent
JUDGE_LLM_MODEL=google/gemini-2.5-flash

# ── RAG knowledge retrieval (configured on the dashboard side) ───────────────
# The Python worker only needs the dashboard base URL + shared secret above.
# Embedding config (EMBEDDING_PROVIDER, GOOGLE_AI_API_KEY, ...) lives in
# dashboard-app/.env.local — see dashboard-app/.env.example.

# ── Outbound campaign dialer (Vobiz AI via LiveKit SIP) ──────────────────────
DIALER_ENABLED=false
DIALER_POLL_INTERVAL_SECONDS=10
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-vobiz-outbound-trunk-id-from-livekit

YANTRIC_AGENT_API_SECRET=replace-with-a-long-random-secret-shared-with-the-dashboard
