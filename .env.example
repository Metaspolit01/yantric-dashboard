# LiveKit Cloud credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Sarvam credentials
SARVAM_API_KEY=your-sarvam-api-key

# LiveKit Inference LLM model (recommended default)
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it

# Twilio outbound call orchestration
# Set these to trigger phone calls to your Android phone when agent.py starts.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15559876543
TWILIO_STATUS_CALLBACK_URL=https://your-app.example/twilio/status
TWILIO_AUTO_DIAL_ON_STARTUP=true
TWILIO_DESTINATION_COUNTRY=IN

# Agent identity
LIVEKIT_AGENT_NAME=my-agent

# Prompt file used by Assistant instructions
AGENT_PROMPT_PATH=prompts/assistant_prompt.txt

# Initial greeting instruction at session start
INITIAL_REPLY_INSTRUCTIONS=Greet the user warmly, then ask how you can help.

# Sarvam STT config
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_FLUSH_SIGNAL=true

# Sarvam TTS config
SARVAM_TTS_TARGET_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_MIN_BUFFER_SIZE=50
SARVAM_TTS_MAX_CHUNK_LENGTH=150
SARVAM_TTS_SEND_COMPLETION_EVENT=true

# Optional: model used by tests to judge response intent
JUDGE_LLM_MODEL=openai/gpt-4.1-mini
