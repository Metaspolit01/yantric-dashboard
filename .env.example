# ═══════════════════════════════════════════════════════════════════════════════
# Yantric — Unified Environment Configuration
# Copy this file to .env and fill in your real values.
# This single file is used by BOTH:
#   • Python voice agent worker  (root — loaded by uv/python-dotenv)
#   • Next.js dashboard app      (dashboard-app — loaded via envDir in next.config)
# NEVER commit .env — it is gitignored.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=yantric-agent

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string used to sign JWT session cookies
JWT_SECRET=replace-with-a-long-random-secret

# ── Shared agent secret ───────────────────────────────────────────────────────
# Must be identical in both environments — the Python worker uses it to
# authenticate requests to the dashboard API, and the dashboard verifies it.
YANTRIC_AGENT_API_SECRET=replace-with-a-long-random-secret-shared-with-the-dashboard

# Base URL of the running dashboard (used by the Python worker to call the API)
YANTRIC_API_BASE_URL=http://localhost:3001

# ── Sarvam AI (STT + TTS) ─────────────────────────────────────────────────────
SARVAM_API_KEY=your-sarvam-api-key

# STT
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_FLUSH_SIGNAL=true

# TTS
SARVAM_TTS_TARGET_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_MIN_BUFFER_SIZE=50
SARVAM_TTS_MAX_CHUNK_LENGTH=150
SARVAM_TTS_SEND_COMPLETION_EVENT=true

# ── LLM ───────────────────────────────────────────────────────────────────────
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it

# Optional: model used by tests to judge response intent
JUDGE_LLM_MODEL=google/gemini-2.5-flash

# ── RAG Knowledge Base (Google Gemini embeddings) ─────────────────────────────
# Get a key at https://aistudio.google.com/apikey
# Set EMBEDDING_PROVIDER=google to enable vector RAG;
# without it, knowledge is truncated into the system prompt instead.
EMBEDDING_PROVIDER=google
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Optional: Gemini model used for translation
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash

# ── Billing ───────────────────────────────────────────────────────────────────
CREDITS_PER_MINUTE=1

# UPI payment details (for credit purchases)
UPI_ID=yantric@upi
UPI_PAYEE_NAME=Yantric AI

# ── Outbound Dialer (Vobiz AI via LiveKit SIP) ────────────────────────────────
# 1) Vobiz console → enable outbound SIP trunk (domain/username/password)
# 2) LiveKit → create outbound SIP trunk with those credentials
# 3) Paste the trunk ID below and set DIALER_ENABLED=true
DIALER_ENABLED=false
DIALER_POLL_INTERVAL_SECONDS=10
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-vobiz-outbound-trunk-id-from-livekit
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# ── Call Recording ────────────────────────────────────────────────────────────
RECORDING_ENABLED=false
RECORDING_S3_BUCKET=

# ── Agent worker settings ─────────────────────────────────────────────────────
AGENT_PROMPT_PATH=prompts/assistant_prompt.txt
INITIAL_REPLY_INSTRUCTIONS=Greet the user warmly, then ask how you can help.
AGENT_IDLE_TIMEOUT_MINUTES=30
