LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=yantric-agent
LIVEKIT_AGENT_ID=
LIVEKIT_ROOM_NAME=yantric-room
LIVEKIT_LLM_MODEL=google/gemini-2.5-flash
LIVEKIT_WEBHOOK_SECRET=your-livekit-webhook-secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-vobiz-outbound-trunk-id

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=replace-with-a-long-random-secret

YANTRIC_AGENT_API_SECRET=replace-with-a-long-random-secret
YANTRIC_API_BASE_URL=http://localhost:3001

SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_FLUSH_SIGNAL=true
SARVAM_TTS_TARGET_LANGUAGE=en-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_MIN_BUFFER_SIZE=50
SARVAM_TTS_MAX_CHUNK_LENGTH=150
SARVAM_TTS_SEND_COMPLETION_EVENT=true

GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=google
EMBEDDING_DIM=768

CREDITS_PER_MINUTE=1
UPI_ID=yantric@upi
UPI_PAYEE_NAME=Yantric AI

DIALER_ENABLED=false
DIALER_POLL_INTERVAL_SECONDS=10
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

AGENT_PROMPT_PATH=prompts/assistant_prompt.txt
INITIAL_REPLY_INSTRUCTIONS=Greet the user warmly, then ask how you can help.
AGENT_IDLE_TIMEOUT_MINUTES=30
